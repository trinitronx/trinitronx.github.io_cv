# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = false

# Matches multiple files with brace expansion notation
[*.{js,html,yml,yaml}]
charset = utf-8
indent_style = space
indent_size = 2

[*.{scss}]
charset = utf-8
indent_style = tab
indent_size = 1

# Tab indentation (no size specified)
[Makefile]
indent_style = tab

# Matches the exact files either package.json, postcss.config.js, or biome.jsonc
[{package.json,postcss.config.js,biome.jsonc}]
indent_style = space
indent_size = 2
